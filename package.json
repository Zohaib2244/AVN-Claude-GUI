{
  "name": "avn-claude-gui",
  "displayName": "AVN Chat",
  "description": "Claude Code + OpenCode CLI as a VS Code Chat participant",
  "version": "0.3.0",
  "publisher": "personal",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "avn.chat",
        "name": "avn",
        "fullName": "AVN",
        "description": "Claude Code or OpenCode CLI — switch backends from the status bar",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Fix issues in the active file"
          },
          {
            "name": "explain",
            "description": "Explain the active file"
          },
          {
            "name": "index",
            "description": "Build .claude/project-context.md"
          },
          {
            "name": "model",
            "description": "Switch model"
          },
          {
            "name": "mode",
            "description": "Switch mode (Ask / Auto / Plan)"
          },
          {
            "name": "think",
            "description": "Toggle extended thinking (Claude only)"
          },
          {
            "name": "help",
            "description": "List available commands"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "avn.openChat",
        "title": "AVN: Open Chat"
      },
      {
        "command": "avn.switchModel",
        "title": "AVN: Switch Model"
      },
      {
        "command": "avn.switchMode",
        "title": "AVN: Switch Mode (Ask / Auto / Plan)"
      },
      {
        "command": "avn.switchThinking",
        "title": "AVN: Switch Thinking Budget"
      },
      {
        "command": "avn.addOpenCodeModel",
        "title": "AVN: Add OpenCode Model"
      },
      {
        "command": "avn.indexProject",
        "title": "AVN: Index Project"
      },
      {
        "command": "avn.showDiff",
        "title": "AVN: Show before/after diff for a file"
      },
      {
        "command": "avn.keepFileChanges",
        "title": "AVN: Keep all AI changes in this file"
      },
      {
        "command": "avn.revertFileChanges",
        "title": "AVN: Revert all AI changes in this file"
      },
      {
        "command": "avn.keepHunk",
        "title": "AVN: Keep this AI change"
      },
      {
        "command": "avn.revertHunk",
        "title": "AVN: Undo this AI change"
      }
    ],
    "keybindings": [
      {
        "command": "avn.openChat",
        "key": "cmd+l",
        "mac": "cmd+l",
        "win": "ctrl+l",
        "linux": "ctrl+l"
      }
    ],
    "configuration": {
      "title": "AVN Chat",
      "properties": {
        "avn.claudeModels": {
          "type": "array",
          "default": [
            "claude-opus-4-7",
            "claude-sonnet-4-6",
            "claude-haiku-4-5",
            "claude-opus-4-5",
            "claude-sonnet-4-5"
          ],
          "description": "Available Claude models"
        },
        "avn.openCodeModels": {
          "type": "array",
          "default": [],
          "description": "Available OpenCode models (format: provider/model). Add from the status-bar model picker."
        },
        "avn.defaultModel": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Default model for new sessions"
        },
        "avn.thinkingModels": {
          "type": "array",
          "default": [
            "claude-opus-4-7",
            "claude-opus-4-5"
          ],
          "description": "Models that support extended thinking"
        },
        "avn.completionDebounceMs": {
          "type": "number",
          "default": 500,
          "description": "Debounce delay in ms for inline completions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
